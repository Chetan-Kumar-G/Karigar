# ─────────────────────────────────────────────────────────────────────────────
#  SIH 26090 — environment template.  Copy to `.env`.  The prototype runs with
#  ZERO configuration (SQLite + deterministic AI fallbacks); every var below is
#  optional and only lights up more real infrastructure.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
SIH_ENVIRONMENT=development
SIH_DEBUG=true
SIH_API_PREFIX=/api

# ── Database ────────────────────────────────────────────────────────────────
# Default (no value needed): SQLite file at backend/data/sih.db
# Postgres (via docker-compose):
# SIH_DATABASE_URL=postgresql+psycopg://sih:sih@localhost:5432/sih
SIH_SQL_ECHO=false

# ── Auth ───────────────────────────────────────────────────────────────────
SIH_JWT_SECRET=change-me-in-production
SIH_JWT_EXPIRY_MINUTES=10080
SIH_MOCK_OTP=123456

# ── F2 — ASR + catalog copy ────────────────────────────────────────────────
# asr_backend: auto | whisper | api | fallback
#   auto  → faster-whisper if installed, else API if SIH_LLM_API_KEY set, else demo
#   To get REAL speech-to-text for the demo, pick ONE:
#     A) set SIH_LLM_API_KEY below (OpenAI-compatible /audio/transcriptions) — works on any Python
#     B) run under Python 3.12 / Docker and `pip install faster-whisper` (no 3.14 wheel yet)
#   Check what's active:  GET /api/catalog/asr-status
SIH_ASR_BACKEND=auto
SIH_WHISPER_MODEL=base          # tiny|base|small|medium — base is a good CPU-demo default
SIH_WHISPER_LANGUAGE=auto       # "auto", or force e.g. hi / ta for a cleaner demo
SIH_ASR_API_MODEL=whisper-1     # model name at the /audio/transcriptions endpoint
# Optional OpenAI-compatible endpoint for (a) Whisper ASR and (b) LLM phrasing.
# Set SIH_LLM_API_KEY to get REAL speech-to-text of the artisan's own voice.
SIH_LLM_ENABLED=false
SIH_LLM_BASE_URL=https://api.openai.com/v1
SIH_LLM_API_KEY=
SIH_LLM_MODEL=gpt-4o-mini

# ── F4 — pricing ──────────────────────────────────────────────────────────
SIH_PRICING_MIN_MARGIN=0.18

# ── F6 — allocation ───────────────────────────────────────────────────────
SIH_F6_LAMBDA=40
SIH_F6_MIN_LOT_SIZE=100
SIH_F6_MAX_ARTISANS_PER_ORDER=8
SIH_F6_SOLVER=cp_sat

# ── F7 — fair ranking weights (spec §9.I) ────────────────────────────────
SIH_F7_ALPHA=1.0
SIH_F7_BETA=0.35
SIH_F7_GAMMA=0.25
SIH_F7_DELTA=0.30
SIH_F7_NEW_SELLER_SALES_THRESHOLD=15

# ── Mobile app → which backend to call ──────────────────────────────────
# (passed to Flutter with --dart-define=API_BASE_URL=...)
# Android emulator reaches the host at 10.0.2.2
API_BASE_URL=http://10.0.2.2:8000/api
